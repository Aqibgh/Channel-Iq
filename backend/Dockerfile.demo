FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirement.demo.txt ./
RUN python -m pip install --upgrade pip && \
    python -m pip install -r requirement.demo.txt

COPY . .

RUN mkdir -p /app/data /app/media /app/logs
COPY docker-entrypoint.demo.sh /usr/local/bin/channel-iq-demo-entrypoint
RUN chmod 0555 /usr/local/bin/channel-iq-demo-entrypoint

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/channel-iq-demo-entrypoint"]
