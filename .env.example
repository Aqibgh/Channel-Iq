# Copy this file to .env for the Docker demo. Never commit the copied file.

# Leave blank for Docker; the demo entrypoint generates and persists a local key.
DJANGO_SECRET_KEY=
DEBUG=False
# For an explicitly local HTTP auth test, set DEBUG=True and SECURE_COOKIES=False.
SECURE_COOKIES=
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Optional backend integrations. Leave blank to run the health endpoint and UI shell.
YOUTUBE_API_KEY=
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
GOOGLE_CLIENT_SECRETS_FILE=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

REACT_APP_API_BASE_URL=http://localhost:8000/api/
REACT_APP_API_TIMEOUT_MS=1800000
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
